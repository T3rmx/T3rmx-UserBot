# T3rmx UserBot environment example
# Copy to .env (or configure in your platform) and fill in YOUR OWN values.
# Never commit real credentials or session strings.

# --- Required ---
APP_ID=
# API_ID is also accepted as a backward-compatible alias for APP_ID
# API_ID=
API_HASH=
STRING_SESSION=
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Telegram numeric user ID of the deployer/owner (controls privileged commands for this instance)
T3RMX_OWNER_ID=

# --- Database (required for persistent Railway/production deployments) ---
# Use your deployment's own PostgreSQL URL/reference (e.g. Railway Postgres reference variable).
# The app must not rely on ephemeral SQLite for production template deployments.
DATABASE_URL=

# --- Optional ---
ALIVE_NAME=T3rmx UserBot
TZ=UTC
ENV=production
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=،
# OWNER_ID is also accepted for compatibility
# OWNER_ID=

# Logging/groups (optional, configure with your own IDs)
# PRIVATE_GROUP_BOT_API_ID=
# PM_LOGGER_GROUP_ID=

# T3rmx-VC (adapter present; verified call-control backend not bundled)
VCMODE=false
VC_SESSION=
# T3RMX_VC_BACKEND=none

# Safety toggles (keep disabled unless you fully trust and review sources)
# T3RMX_ALLOW_RUNTIME_PIP_INSTALL=false
# T3RMX_ALLOW_EXTERNAL_REPOS=false
