# T3rmx UserBot environment example
# Copy to .env (or configure in your platform) and fill required values.
# Never commit real credentials or session strings.

# --- Required ---
APP_ID=
# API_ID is also accepted for compatibility
# API_ID=
API_HASH=
STRING_SESSION=
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# --- Identity/runtime (backward-compatible) ---
ALIVE_NAME=T3rmx UserBot
TZ=Asia/Aden
ENV=production

# --- Optional ---
# Recommended: PostgreSQL URL for persistent data (SQLite fallback is not durable on Railway/ephemeral storage)
DATABASE_URL=
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=،
# Deployment owner Telegram user ID (required for privileged/owner commands). Set to YOUR Telegram ID.
T3RMX_OWNER_ID=
# OWNER_ID is also accepted for compatibility
# OWNER_ID=

# Logging/groups (optional, configure with your own IDs)
# PRIVATE_GROUP_BOT_API_ID=
# PM_LOGGER_GROUP_ID=

# T3rmx-VC (adapter present; verified call-control backend not bundled)
VCMODE=false
VC_SESSION=
# T3RMX_VC_BACKEND=none

# Safety toggles (keep disabled unless you fully trust and review sources)
# T3RMX_ALLOW_RUNTIME_PIP_INSTALL=false
# T3RMX_ALLOW_EXTERNAL_REPOS=false
